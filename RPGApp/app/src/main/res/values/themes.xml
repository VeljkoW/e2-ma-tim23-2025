<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RPGApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_color</item>
        <item name="android:colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Theme.RPGApp" parent="Base.Theme.RPGApp" />
    
    <!-- Theme for Auth activities without action bar -->
    <style name="Theme.RPGApp.NoActionBar" parent="Theme.RPGApp">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/primary_color</item>
    </style>
</resources>